# Postgres in production, defaults to local SQLite if unset.
DATABASE_URL=sqlite:///adradar.db

# Meta Ad Library API — register an app at developers.facebook.com and
# request Ad Library access to get this. Leave unset to run ingest in
# dry-run mode against fixture data.
META_ACCESS_TOKEN=

# Used by classify.py to tag each ad's angle (discount, testimonial, ...).
# Leave unset to run classify in dry-run mode.
ANTHROPIC_API_KEY=

# Countries to query the Ad Library for, comma-separated ISO codes.
AD_REACHED_COUNTRIES=US

# Where swipe-file saves land on disk (Phase 0 storage — swap for S3/R2 later).
SWIPE_FILE_DIR=./swipe_file

# Countries the Meta Ad Library *scraper* searches in (platform="meta_scrape"
# competitors), comma-separated ISO codes. Meta's country selector doesn't
# accept a combined value, so the scraper runs one full search per country
# and merges results — list every country a tracked page might be
# geo-classified under.
SCRAPE_COUNTRIES=EG
